{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zvec-ai/zvec-grep/compat/schema/cli-case.schema.json",
  "title": "zvec-grep CLI compatibility case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "description", "input", "expected"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd_fixture"],
      "properties": {
        "argv": { "type": "array", "items": { "type": "string" } },
        "cwd_fixture": { "type": "string", "minLength": 1 },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "stdout", "stderr"],
      "properties": {
        "exit_code": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" }
      }
    },
    "allowed_differences": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
