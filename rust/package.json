{
  "name": "zvec-grep-rust-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/npm-release.mjs build",
    "check": "bash scripts/check.sh && npm run test:package",
    "install:local": "node scripts/npm-local.mjs install",
    "pack:local": "node scripts/npm-local.mjs pack",
    "release:verify": "node scripts/npm-release.mjs verify",
    "release:platform": "node scripts/npm-release.mjs pack-platform",
    "release:meta": "node scripts/npm-release.mjs pack-meta",
    "release:pack": "node scripts/npm-release.mjs pack-current",
    "release:cpu": "node scripts/npm-release.mjs pack-current --cpu-only",
    "release:smoke": "node scripts/npm-release.mjs smoke-artifacts",
    "release:artifact-smoke": "node scripts/npm-release.mjs smoke-artifacts",
    "release:collect": "node scripts/npm-release.mjs collect",
    "release:publish": "node scripts/npm-release.mjs publish",
    "release:promote": "node scripts/npm-release.mjs promote",
    "release:registry-smoke": "node scripts/npm-release.mjs smoke-registry",
    "test": "npm run build && cargo test --workspace && node --test scripts/npm-local.test.mjs npm/meta/install.test.cjs",
    "test:package": "npm run build && node scripts/npm-local.mjs smoke --no-build"
  }
}
