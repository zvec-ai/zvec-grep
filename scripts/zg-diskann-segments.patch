+
+// This runtime is shared by zg's Rust and Node bindings. Only their embedding
+// collections opt in; metadata collections and HNSW keep native maintenance.
+void CollectionImpl::configure_zg_diskann_segments() {
+  const auto name = schema_->name();
+  const auto *field = schema_->get_vector_field("embedding");
+  full_diskann_segments_ =
+      (name == "fragments" || name == "zvec_grep_entities") && field &&
+      field->index_type() == IndexType::DISKANN;
+  if (full_diskann_segments_) {
+    schema_->set_max_doc_count_per_segment(200000);
+  }
 }
 
